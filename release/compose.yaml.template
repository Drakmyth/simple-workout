services:
  app:
    image: ghcr.io/drakmyth/simple-workout:{{VERSION}}
    environment:
      LISTEN_ADDRESS: :8080
      DATA_DIR: /data
    volumes:
      - workout-data:/data
    ports:
      - "${HTTP_BIND_ADDRESS:-127.0.0.1}:${HTTP_PORT:-8080}:8080"
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:8080/health"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 5s
    restart: unless-stopped

volumes:
  workout-data:
